// A conexão fica em prisma.config.ts (Prisma 7): a CLI usa a URL direta e a
// aplicação conecta pelo pooler através do adapter @prisma/adapter-pg.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Valores espelhados em packages/shared/src/enums.ts
enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  /// Sempre gravado em minúsculas pela camada de serviço.
  email          String    @unique
  passwordHash   String
  name           String
  role           Role      @default(CUSTOMER)
  /// Só faz sentido para AGENT: entra na atribuição automática quando true.
  isAvailable    Boolean   @default(true)
  /// Desempate da atribuição por menor carga (quem recebeu há mais tempo).
  lastAssignedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  requestedTickets Ticket[]       @relation("TicketRequester")
  assignedTickets  Ticket[]       @relation("TicketAssignee")
  comments         Comment[]
  refreshTokens    RefreshToken[]

  @@index([role, isAvailable])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// SHA-256 do token; o valor em claro só existe no cookie do usuário.
  tokenHash String    @unique
  /// Todos os tokens de uma mesma cadeia de rotação. Reuso de um token já
  /// rotacionado revoga a família inteira.
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Ticket {
  id          String       @id @default(uuid()) @db.Uuid
  /// Número legível exibido como #123.
  number      Int          @unique @default(autoincrement())
  title       String
  description String
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)
  requesterId String       @db.Uuid
  assigneeId  String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // SLA — prazos materializados para filtrar/ordenar em SQL. Ao retomar de
  // uma pausa, o tempo pausado é somado aos dois prazos e a pausedSeconds.
  firstResponseAt    DateTime?
  firstResponseDueAt DateTime
  resolutionDueAt    DateTime
  slaPausedAt        DateTime?
  pausedSeconds      Int       @default(0)
  resolvedAt         DateTime?
  closedAt           DateTime?

  requester User      @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee  User?     @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments  Comment[]

  @@index([status])
  @@index([assigneeId, status])
  @@index([requesterId])
  @@index([resolutionDueAt])
  @@map("tickets")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  authorId   String   @db.Uuid
  body       String
  /// Nota interna: visível só para AGENT/ADMIN e não conta como 1ª resposta.
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("comments")
}

model SlaPolicy {
  priority             Priority @id
  firstResponseMinutes Int
  resolutionMinutes    Int
  updatedAt            DateTime @updatedAt

  @@map("sla_policies")
}
