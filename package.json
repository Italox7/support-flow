{
  "name": "support-flow",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "npm run build -w @support-flow/shared",
    "dev:api": "npm run dev -w @support-flow/api",
    "dev:web": "npm run dev -w @support-flow/web",
    "build": "npm run build -w @support-flow/shared && npm run build -w @support-flow/api && npm run build -w @support-flow/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0",
    "typescript-eslint": "^8.72.0"
  }
}
