# Copie para apps/api/.env e preencha. O .env nunca é versionado.
#
# Supabase → Connect → ORMs → Prisma. Use o MESMO projeto com schemas diferentes:
#   desenvolvimento local → ?schema=dev
#   demo pública (Render) → ?schema=public

# Pooler (porta 6543): usado pela aplicação em tempo de execução.
DATABASE_URL="postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?schema=dev"

# Conexão direta / session pooler (porta 5432): usada só pela CLI do Prisma (migrations).
DIRECT_URL="postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?schema=dev"

PORT=3000
NODE_ENV=development

# Segredo do access token (HS256, mínimo 32 caracteres). Gere um por ambiente:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=

# Proxies confiáveis à frente da API (IP real para o rate limit). 0 localmente.
TRUST_PROXY=0

# Só para o seed do admin (`npm run build && npm run db:seed`, em apps/api).
# Senha com no mínimo 12 caracteres; rodar de novo não troca a senha existente.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
